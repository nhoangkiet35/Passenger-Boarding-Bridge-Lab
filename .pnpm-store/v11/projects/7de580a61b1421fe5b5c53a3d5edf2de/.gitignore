# Dependencies and package-manager caches
node_modules/
.pnpm-store/
.pnp.*
.yarn/cache/
.yarn/unplugged/

# Generated application output and caches
# Keep pbb-lab/build/: it contains source for the Vite plugin.
dist/
dist-vercel/
.next/
.vinext/
out/
.vite/
.turbo/
.cache/
*.tsbuildinfo
next-env.d.ts

# Local Cloudflare / Sites runtime state
.wrangler/
.sites-runtime/
.vercel/

# Test reports and temporary artifacts
coverage/
test-results/
playwright-report/
outputs/
work/
/pbb-lab-source.zip

# Local environment files; allow reusable examples
.env
.env.*
!.env.example
!.env.*.example
!.env.sample

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Credentials and private certificates
*.pem
*.key
*.p12
*.pfx

# Machine-specific editor and OS files
.idea/
*.suo
*.user
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Local agent/tool state
.agents/
.codex/

# Keep source and reproducible configuration tracked:
# pnpm-lock.yaml, package.json, .npmrc, .openai/hosting.json, build/, public/

.vercel
.env*
