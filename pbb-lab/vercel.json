{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist-vercel",
  "rewrites": [
    {
      "source": "/ground-ops",
      "destination": "/index.html"
    },
    {
      "source": "/ground-ops/",
      "destination": "/index.html"
    },
    {
      "source": "/vdgs",
      "destination": "/index.html"
    },
    {
      "source": "/vdgs/",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/api/admin?view=home"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/admin?view=:path*"
    }
  ],
  "functions": {
    "api/explore.mjs": {
      "includeFiles": ".private-explore/**"
    },
    "api/admin.mjs": {
      "includeFiles": "{.private-explore/**,server/data/*.xlsx}"
    }
  },
  "redirects": [
    {
      "source": "/about/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/explore",
      "destination": "/admin/explore",
      "permanent": false
    },
    {
      "source": "/explore/",
      "destination": "/admin/explore",
      "permanent": false
    },
    {
      "source": "/admin/",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/admin/login/",
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/admin/explore/",
      "destination": "/admin/explore",
      "permanent": false
    }
  ]
}
